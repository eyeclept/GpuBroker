# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# GPU Broker port
GPU_BROKER_PORT=8792

# GPU safety margin in MB. Baseline idle usage (desktop compositor + driver reserve
# + any stray usage). Measure empirically with:
#   nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits
# (all clients/Ollama stopped, no game running). That baseline plus a small buffer
# is the margin. Default 1536 is a placeholder, not measured.
GPU_SAFETY_MARGIN_MB=1536

# Path to persist lease ledger (JSON file with atomic writes)
GPU_BROKER_LEDGER_PATH=/data/leases.json

# Ollama API endpoint. Since GpuBroker-Proxy took over host port 11434 (see
# ../GpuBroker-Proxy/), this points at Ollama's compose service name over
# the shared ollama_default network (this repo's own docker-compose.yml
# joins it) rather than through the proxy -- this poll is read-only
# telemetry, never meant to be admission-gated. If GpuBroker-Proxy is not
# deployed, use http://host.containers.internal:11434 instead (Ollama's own
# original host-published address).
OLLAMA_URL=http://ollama:11434

# Ollama model list poll interval in seconds
OLLAMA_POLL_INTERVAL_SECONDS=20

# Lease sweeper interval in seconds (reclaims stale leases)
GPU_BROKER_SWEEP_INTERVAL_SECONDS=30

# Lease time-to-live in seconds (heartbeat not seen within this period = reclaim)
GPU_BROKER_LEASE_TTL_SECONDS=180
