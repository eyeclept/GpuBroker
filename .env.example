# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# GPU Broker port
GPU_BROKER_PORT=8792

# GPU safety margin fallback in MB. Used until the non-lease poller has
# NON_LEASE_MIN_SAMPLES unlocked samples, then p95 of those samples
# takes over (floored at GPU_SAFETY_MARGIN_MIN_MB). Keep this at a
# measured idle baseline plus buffer so a cold-start broker does not
# admit recklessly. Default 1536 is a placeholder, not measured.
GPU_SAFETY_MARGIN_MB=1536

# Floor on the computed p95, in MB. Defaults to GPU_SAFETY_MARGIN_MB
# when unset. Stops a quiet-desktop window from shrinking the margin
# below the last operator-set fallback.
GPU_SAFETY_MARGIN_MIN_MB=1536


# Path to persist lease ledger (JSON file with atomic writes)
GPU_BROKER_LEDGER_PATH=/data/leases.json

# Rolling non-lease overhead history (JSON, atomic write like the ledger)
NON_LEASE_USAGE_PATH=/data/non_lease_usage.json


# Ollama API endpoint. GpuBroker-Proxy now owns host port 11434 (see
# ../GpuBroker-Proxy/). This points at Ollama's compose service name on
# the shared ollama_default network (this repo's docker-compose.yml
# joins it), not through the proxy. This poll is read-only telemetry,
# never admission-gated. If GpuBroker-Proxy is not deployed, use
# http://host.containers.internal:11434 instead (Ollama's original
# host-published address).
OLLAMA_URL=http://ollama:11434

# Ollama footprint poll interval in seconds
OLLAMA_POLL_INTERVAL_SECONDS=20


# Non-lease (desktop/compositor/Steam/browser/driver) overhead poll
NON_LEASE_POLL_INTERVAL_SECONDS=30


# Hours of samples kept for the p95. 48 covers two weekday work cycles
# without pinning a weekend game session for half a week.
NON_LEASE_WINDOW_HOURS=48

# Minimum unlocked samples before p95 replaces GPU_SAFETY_MARGIN_MB.
# 60 at the 30s default is 30 minutes.
NON_LEASE_MIN_SAMPLES=60

# Unmanaged heavy load (a game, a render): VRAM at or above this many MB
# outside container processes (nvidia-smi used minus GPU memory of
# processes in a podman/docker container). While load is above it, every
# preemptible lease (FreeToken) is flagged to self-evict and every new
# acquire (any caller, any mb) gets 503 with Retry-After until it has
# been gone for the clear time. Non-lease samples at or above it are
# also excluded from the baseline p95 above.
# Desktop baseline here is 1.0-1.7 GB; a game was seen at ~10 GB. Set it
# above your heaviest non-game desktop use and below your lightest game.
UNMANAGED_YIELD_OVERHEAD_MB=4096
# Seconds between detection polls. Short so a model yields before the game stutters.
UNMANAGED_POLL_INTERVAL_SECONDS=5
# Consecutive over-threshold polls before declaring heavy load.
UNMANAGED_ENTER_SAMPLES=2
# Seconds continuously below threshold before declaring it over.
UNMANAGED_CLEAR_SECONDS=120

# Independently of this VRAM threshold, the broker detects Steam Proton
# launch wrappers through the host PID namespace. It refuses all new
# leases while a Proton game runs and for 30 minutes after it exits.
# This cooldown is fixed, persists in the lease ledger, and is not the
# UNMANAGED_CLEAR_SECONDS threshold hysteresis.



# Lease sweeper interval in seconds (reclaims stale leases)
GPU_BROKER_SWEEP_INTERVAL_SECONDS=30

# Lease time-to-live in seconds (heartbeat not seen within this period = reclaim)
GPU_BROKER_LEASE_TTL_SECONDS=180

# Shared secret for POST /admin/clear (force-kills every GPU compute
# process on the host, then resets the lease ledger). See server.py
# admin_clear() and Assist/HANDOVER_post_admission_oom.md. Unset (the
# default) disables the endpoint. It returns 501 rather than running
# without a token. The broker listens on the docker network, not only
# loopback, so any container that can reach /acquire can also reach
# /admin/clear. Set a real secret before using this, for example
# `openssl rand -hex 32`. Also requires docker-compose.yml `pid: host`
# on the gpubroker service to see and signal real host PIDs.
GPU_BROKER_ADMIN_TOKEN=

# Extra Host header names, comma-separated. Appended to the built-in
# list: localhost, 127.0.0.1, ::1, host.containers.internal. A Host
# not on the list returns 400 (DNS rebinding). Leave empty unless a
# caller uses another hostname.
GPU_BROKER_ALLOWED_HOSTS=
