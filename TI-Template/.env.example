# Broker URL: default works when broker runs as a container or is reached from
# another container on the same host via podman's bridge gateway
BROKER_URL=http://host.containers.internal:8792

# BROKER_FAIL_OPEN: choose true or false based on YOUR service's needs, not blindly
# - Set to "true" if your service has a safe "proceed without broker coordination" fallback
#   (e.g., Flux2Klein9B fails open because it can still generate images without the broker,
#    just risking OOM if resources collide with other services)
# - Set to "false" if your service MUST reject requests it cannot coordinate with the broker
#   (e.g., Needle fails closed because uncoordinated inference risks crashing the whole runtime)
# This is a deliberate per-service choice, not a universal default.
BROKER_FAIL_OPEN=true
