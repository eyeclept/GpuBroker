# Broker URL. Default works when the broker runs as a container, or when
# another container on the same host reaches it via podman's bridge gateway.
BROKER_URL=http://host.containers.internal:8792

# BROKER_FAIL_OPEN default is false (fail closed) in both templates.
# true: after transport retries fail, proceed without a lease.
# false: raise BrokerUnavailable after those retries.
# Explicit broker answers (504, 503, 422, 400) never fail open.
# Pick true only when the service can run with no GPU coordination
# (Flux2Klein9B can still generate, with OOM risk on collision).
# Needle stays false so uncoordinated inference cannot crash the runtime.
BROKER_FAIL_OPEN=false
