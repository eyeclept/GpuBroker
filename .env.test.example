# Env for docker-compose.test.yml's isolated test broker instance (port
# 8798). Copy to .env.test before `podman compose -f docker-compose.test.yml
# up`. See that file's header comment for why each value here differs from
# .env.example.

LOG_LEVEL=INFO

# Same in-container port as the live broker (8792) -- docker-compose.test.yml
# publishes it externally as 8798 instead, so both instances can run at once.
GPU_BROKER_PORT=8792

# Matches the live broker's current measured baseline. Irrelevant to the
# mocked nvidia-smi readings themselves, but kept realistic so admission-
# formula testing against this instance behaves like production sizing.
GPU_SAFETY_MARGIN_MB=4864

# Own ledger, separate from the live broker's data/leases.json.
GPU_BROKER_LEDGER_PATH=/data/leases.json

# Not joined to the ollama_default network on this instance -- resolves
# nowhere from inside the container, so _poll_ollama holds ollama_mb at 0.0
# via its existing try/except. Expected, not a bug.
OLLAMA_URL=http://ollama:11434
OLLAMA_POLL_INTERVAL_SECONDS=20
GPU_BROKER_SWEEP_INTERVAL_SECONDS=30
GPU_BROKER_LEASE_TTL_SECONDS=180

# Left unset: the dashboard never needs this, and /admin/clear should stay
# disabled (501) on the test instance same as the live broker's default.
GPU_BROKER_ADMIN_TOKEN=

# Extra Host names appended to localhost, 127.0.0.1, ::1, and
# host.containers.internal. Empty keeps the in-container healthcheck
# (localhost) and client-container DNS working. A disallowed Host
# returns 400.
GPU_BROKER_ALLOWED_HOSTS=
