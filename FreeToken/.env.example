# HF repo id. The originally-planned checkpoint
# primitive-ai/Ornith-1.5-35B-A3B-mixed-NVFP4-FP8 does NOT load on FreeToken
# 0.1.2 (upstream issue #238; PR #294 tested and insufficient -- see
# README.md). The Ornith org's official NVFP4 export is the closest working
# substitute: same 35B-A3B MoE, same minimal-footprint intent (max VRAM/RAM
# budget left for KV cache, the stated service priority).
FREETOKEN_MODEL=ornith-ai/Ornith-1.5-35B-A3B-NVFP4

# Reported by /v1/models and used as the registry.json routing key in
# ../GpuBroker-Proxy/registry.json. Change both together.
FREETOKEN_SERVED_MODEL_NAME=ornith-1.5-35b-a3b

FREETOKEN_HOST=0.0.0.0
FREETOKEN_PORT=1919

# ft serve binds 127.0.0.1 on this port inside the container. Only the
# wrapper on FREETOKEN_PORT is published.
FREETOKEN_INTERNAL_PORT=1920

# Seconds with no request in flight before the wrapper stops ft serve and
# releases its GPU lease. Cost: the first request after an unload waits
# for a full model load (~50 s warm on this host). The idle check runs
# every 5 s, so the unload lands up to 5 s after this.
FREETOKEN_IDLE_SECONDS=60

# Upper bound on one model load, in seconds. A load that takes longer is
# stopped, its lease released, and the waiting requests get a 503. 1800
# covers a first boot that downloads the ~20 GB checkpoint.
FREETOKEN_LOAD_TIMEOUT_SECONDS=1800

# Ollama API used to unload resident Ollama models before each load, so
# ft serve sees enough free VRAM. GpuBroker-Proxy forwards it to Ollama.
FREETOKEN_OLLAMA_URL=http://host.containers.internal:11434

# Longest a request waits for a lease while the broker answers 504 (no room).
# The wrapper backs off 2 s doubling to 60 s between attempts. The broker
# keeps the wait age across retries, so an idle preemptible holder (Laya,
# Flux, Whisper) is asked to yield after about 90 s.
FREETOKEN_ACQUIRE_WAIT_SECONDS=300

# hybrid: ft bench bw on this host measured CPU 55.1 GB/s vs PCIe 13.2 GB/s
# (3.9x for NVFP4, above the 2.0x threshold), so 25.2% of decode-step expert
# misses stream over PCIe and the rest compute on the CPU pool. offload also
# works; hybrid decodes faster. See README.md.
FREETOKEN_MOE_BACKEND=hybrid

# Fixed 2026-09-01: the previous config (--kv-reserve-tokens 65536 +
# explicit --moe-cache-size 512) silently allocated as little as 814-3547
# KV tokens under this host's normal GPU contention, because
# --kv-reserve-tokens only takes effect "before --moe-cache-auto fills
# experts" (ft serve --help) -- with an explicit --moe-cache-size it is
# ignored, so KV got whatever was left of a memory-ratio budget that
# itself shrinks whenever another GPU consumer (llama-swap, via the
# separate known GPU_SAFETY_MARGIN_MB broker accounting gap) is resident
# at boot. --moe-cache-auto makes --kv-reserve-tokens a real, enforced
# floor instead. Same-session fix landed at --kv-reserve-tokens 57344
# (65536 dropped for margin against llama-swap contention -- see below).
#
# Raised back to 65536 on 2026-09-02, after llama-swap was permanently
# retired (Ornith-1.5-35B-A3B via FreeToken replaces the dense/MoE chat
# models it served) -- the VRAM contention that forced the 57344 backoff
# no longer exists. 65536 alone still missed the cache-budget assertion
# by a small margin (~7-46 MB short across two boot attempts, confirmed
# live); memory-ratio 0.63 -> 0.65 closed that gap. Verified across 3
# consecutive clean boots (65572-65611 KV tokens each, no collapse) plus
# real large-context requests up to 64200 prompt tokens (HTTP 200).
# New verified ceiling: 65611 tokens (prompt + generation), confirmed via
# a live overflow test ("68700 tokens > 65611 maximum"), up from 58665.
FREETOKEN_EXTRA_ARGS=--memory-ratio 0.65 --moe-cache-auto --kv-reserve-tokens 65536 --cuda-graph-max-bs 1

# GpuBroker lease size in MB. MUST be a measured nvidia-smi peak (weights
# + MoE cache + KV + working memory) from a real load+inference cycle, per
# ../examples/sizing_a_request.md -- never the checkpoint's on-disk size.
# Re-measured 2026-09-02 with the expanded 65536-token KV config above:
# real peak during a large-context request (isolated via
# `nvidia-smi --query-compute-apps`, confirmed identical across two
# independent requests at 50700 and 64200 prompt tokens) is a stable
# 8126 MB -- 220 MB higher than the 7906 MB peak measured under the
# smaller 57344-token KV pool, consistent with the larger fixed-size KV
# allocation (1.25 GiB vs 1.10 GiB). 8382 = 8126 + 256 margin, same
# buffer convention as every prior derivation in this file's history.
# budget_mb on this host is 9282 MB (12282 total - 3000
# GPU_SAFETY_MARGIN_MB), leaving 900 MB of headroom for other
# broker-coordinated consumers (currently just Ollama; llama-swap is
# retired) rather than leasing right up to the ceiling.
FREETOKEN_ACQUIRE_MB=8382

# Beat interval. 5s so a game-triggered preempt flag is seen within seconds.
FREETOKEN_HEARTBEAT_INTERVAL_SECONDS=5

# GpuBroker configuration
BROKER_URL=http://host.containers.internal:8792

# false: fail closed. While loaded, FreeToken holds a large resident-VRAM
# working set on a card shared with Ollama, Flux2Klein9B, Talkie, Needle,
# and games. An uncoordinated load risks exceeding the card's real
# remaining budget and OOMing this process or a sibling. A denied or
# failed acquire returns 503 to the client and does not start ft serve.
# See README.md.
BROKER_FAIL_OPEN=false

LOG_LEVEL=INFO
