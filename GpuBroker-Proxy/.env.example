# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Port the proxy listens on. Takes over Ollama's own 11434 -- Ollama itself
# no longer publishes this port once the proxy is live (see
# ~/Documents/Code/Docker/Ollama/docker-compose.yml).
GPUBROKER_PROXY_PORT=11434

# GpuBroker URL. This proxy calls /acquire and /release around gated
# requests (those with a "model" field). Metadata calls are not gated.
BROKER_URL=http://host.containers.internal:8792

# Fail open (forward traffic unmetered) if the broker is unreachable,
# rather than blocking all Ollama/OAIE traffic on one failure. Matches
# Flux2Klein9B's default. Ollama's footprint has always been tracked
# passively, so an unmetered race here is an accepted risk (see
# Assist/TODO.md Phase 5), not a new regression from this proxy.
BROKER_FAIL_OPEN=true

# How long each gated request waits for the broker to admit it before
# this proxy gives up and returns 429. Bounds added latency under GPU
# contention. Keep short. OAIE clients are usually interactive.
BROKER_ACQUIRE_TIMEOUT_S=10.0

# Retry-After value (seconds) returned to the OAIE caller on a 429.
PROXY_RETRY_AFTER_SECONDS=3.0

# Path to the model -> backend registry (baked into the image; see
# registry.json in this folder).
PROXY_REGISTRY_PATH=/app/registry.json
